      "xStart": 0,
      "xEnd": 700,
      "intent": "操作と世界観を安全に理解する"
    },
    {
      "id": "jump-tutorial",
      "label": "ジャンプ練習区画",
      "xStart": 700,
      "xEnd": 1550,
      "intent": "低い段差から高低差のあるルートへ導く"
    },
    {
      "id": "crystal-assay",
      "label": "結晶析出区画",
      "xStart": 1550,
      "xEnd": 2350,
      "intent": "紫の危険結晶と安全な結晶装置の色分けを覚える"
    },
    {
      "id": "checkpoint-run",
      "label": "チェックポイント区画",
      "xStart": 2350,
      "xEnd": 3150,
      "intent": "回収テンポを上げて終盤へつなぐ"
    },
    {
      "id": "gate-approach",
      "label": "中継ゲート前",
      "xStart": 3150,
      "xEnd": 4000,
      "intent": "移動床を越えて追加区画へ進む"
    },
    {
      "id": "drone-gallery",
      "label": "ドローン試験区画",
      "xStart": 4000,
      "xEnd": 4800,
      "intent": "予告線を見て低いレーザーをジャンプで回避する"
    },
    {
      "id": "final-descent",
      "label": "最下段への降下",
      "xStart": 4800,
      "xEnd": 5600,
      "intent": "最下段へ降り、まだ走査していない奥の区画へ進む"
    },
    {
      "id": "reboot-corridor",
      "label": "再始動回廊",
      "xStart": 5600,
      "xEnd": 6560,
      "intent": "最下段で走りを取り戻し、上段に取り分があることを見せる"
    },
    {
      "id": "spike-garden",
      "label": "析出庭園",
      "xStart": 6560,
      "xEnd": 7480,
      "intent": "床の紫結晶を跳ぶか、安全な棚を選ぶかを決めさせる"
    },
    {
      "id": "crystal-relay",
      "label": "結晶リレー",
      "xStart": 7480,
      "xEnd": 8440,
      "intent": "遠隔スイッチで横向き結晶足場を生成して上段へ渡る。1Fの主役ギミックを完成形で使う"
    },
    {
      "id": "conveyor-yard",
      "label": "搬送ヤード",
      "xStart": 8440,
      "xEnd": 9400,
      "intent": "横移動と上下移動の搬送ラインを乗り継いで高い経路へ上がる"
    },
    {
      "id": "specimen-shelf",
      "label": "標本棚",
      "xStart": 9400,
      "xEnd": 10360,
      "intent": "高い棚に大きい取り分を置き、搬送ラインを選んだ走りに報いる"
    },
    {
      "id": "exit-hall",
      "label": "退出ホール",
      "xStart": 10360,
      "xEnd": 11216,
      "intent": "危険を置かず、昇降リフトで研究所2Fへ降りる"
    }
